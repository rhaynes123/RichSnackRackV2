@page
@model SnackRack.Pages.Features.Products.Menu

@{
}
<h2 class="mb-3">Products</h2>

<form method="get" class="mb-4">
    <div class="input-group">
        <input type="text"
               name="SearchTerm"
               value="@Model.SearchTerm"
               class="form-control"
               placeholder="Describe what you're craving, e.g. 'something salty and crunchy'..." />
        <button class="btn btn-primary" type="submit">Search</button>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
    {
        <small class="text-muted mt-1 d-block">
            Semantic results for "@Model.SearchTerm" —
            <a asp-page="/Features/Products/Menu">Clear</a>
        </small>
    }
</form>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
    <tr>
        <th>Name</th>
        <th class="text-end">Price</th>
        <th class="text-center">Description</th>
        
        <th class="text-center">Order?</th>
        <th class="text-center">Read Reviews</th>
        <th class="text-center">Want to Leave a Review?</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var product in Model.ActiveProducts)
    {
        <tr>
            <td>@product.Name</td>
            <td class="text-end">@product.Price.ToString("C")</td>
            <td class="text-center">@product.Description</td>
            <td class="text-center">
                <a asp-page="/Features/Orders/Create"
                   asp-route-productId="@product.Id"
                   class="btn btn-sm btn-primary">
                    Order
                </a>
            </td>
            <td class="text-end">
                <a asp-page="/Features/Reviews/AllReviews"
                   asp-route-SearchTerm="@product.Name"
                   class="btn btn-sm btn-success">
                    Read Reviews
                </a>
            </td>
            <td class="text-end">
                <a asp-page="/Features/Reviews/Create"
                   asp-route-productId="@product.Id"
                   class="btn btn-sm btn-success">
                    Leave Review
                </a>
            </td>
        </tr>
    }
    </tbody>
</table>