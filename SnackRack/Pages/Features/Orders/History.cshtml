@page
@model SnackRack.Pages.Features.Orders.HistoryModel

@{
    ViewData["Title"] = "My Order History";
}

<partial name="_OrdersTabNav" model='"my-orders"' />

@if (!Model.OrderGroups.Any())
{
    <div class="alert alert-info">You have no orders yet.</div>
}
else
{
    foreach (var order in Model.OrderGroups)
    {
        <div class="card mb-4 shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <span class="fw-semibold">Order</span>
                    <span class="font-monospace text-secondary ms-2 small">@order.OrderId</span>
                </div>
                <div class="d-flex gap-3 align-items-center">
                    <span class="text-muted small">@order.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
                    <span class="badge bg-primary">@order.Status</span>
                    <span class="fw-semibold">@order.OrderTotal.ToString("C")</span>
                </div>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Product</th>
                            <th class="text-end">Price</th>
                            <th class="text-end">Qty</th>
                            <th class="text-end">Subtotal</th>
                            <th>Review</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in order.Items)
                        {
                            <tr>
                                <td>@item.ProductName</td>
                                <td class="text-end">@item.Price.ToString("C")</td>
                                <td class="text-end">@item.Quantity</td>
                                <td class="text-end">@item.LineTotal.ToString("C")</td>
                                <td>
                                    @if (item.HasReview)
                                    {
                                        <span class="text-success fw-semibold" title="@item.ReviewComment">
                                            &#10003; @item.ReviewTitle
                                        </span>
                                    }
                                    else
                                    {
                                        <a asp-page="/Features/Reviews/Create"
                                           asp-route-productId="@item.ProductId"
                                           class="btn btn-sm btn-outline-secondary">
                                            Write a review
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}
